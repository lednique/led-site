VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Необязательно: почта администратора подставится в форму входа на /admin.
# Сам вход — через Supabase Auth (Authentication → Users → Add user).
VITE_ADMIN_EMAIL=admin@example.com

# Какая версия сайта показывается в локальной разработке: ru (по умолчанию)
# или global. В продакшне регион определяется по IP в api/region.ts.
VITE_DEV_REGION=global

# Запасной вход в панель — нужен ТОЛЬКО если сайт работает без Supabase.
# Серверная переменная (без VITE_), в браузер не попадает.
ADMIN_PASSWORD=change-me

# Серверные переменные Telegram-бота больше не нужны: формы на сайте нет,
# заявки идут через mailto (src/contacts.ts) и ссылку на Telegram.
